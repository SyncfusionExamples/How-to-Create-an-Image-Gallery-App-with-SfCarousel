<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:carousel="clr-namespace:Syncfusion.Maui.Carousel;assembly=Syncfusion.Maui.Carousel"
             x:Class="ImageGalleryCarousel.MainPage"
             xmlns:viewModel="clr-namespace:ImageGalleryCarousel">

    <ContentPage.BindingContext>
        <viewModel:GalleryViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Background>
        <LinearGradientBrush EndPoint="1,1">
            <GradientStop Color="#F8FAFC" Offset="0"/>
            <GradientStop Color="#E0F2FE" Offset="0.5"/>
            <GradientStop Color="#EEF2FF" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>
    <Grid Padding="20"
          RowDefinitions="Auto,*">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Margin="0,10,0,20"
                             Spacing="5">

            <Label Text="📸 Travel Gallery"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="#0F172A"/>
            <Label Text="Explore iconic destinations around the world"
                   FontSize="15"
                   TextColor="#64748B"/>
        </VerticalStackLayout>
        <!-- Gallery Carousel -->
        <carousel:SfCarousel Grid.Row="1"
                             ItemWidth="320"
                             ItemHeight="500"
                             ItemsSource="{Binding Places}"
                             SelectedIndex="2"
                             ItemSpacing="15"
                             ViewMode="Default">
            <carousel:SfCarousel.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 35">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.20"
                                    Radius="18"
                                    Offset="2,8"/>
                        </Border.Shadow>
                        <Grid>
                            <!-- Tourist Image -->
                            <Image
                                Source="{Binding Image}"
                                Aspect="AspectFill"/>
                            <!-- Overlay -->
                            <Border
                                VerticalOptions="End"
                                StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">
                                        <GradientStop
                                            Color="#00000000"
                                            Offset="0"/>
                                        <GradientStop
                                            Color="#E6000000"
                                            Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <VerticalStackLayout Padding="20"
                                                     Spacing="4">
                                    <Label Text="{Binding Title}"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           TextColor="White"/>
                                    <Label Text="{Binding Country}"
                                           FontSize="16"
                                           TextColor="White"/>
                                    <Label Text="⭐ 4.9 Rating"
                                           FontSize="13"
                                           TextColor="White"/>
                                    <Label Text="📍 Featured Destination"
                                           FontSize="13"
                                           TextColor="White"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </carousel:SfCarousel.ItemTemplate>
        </carousel:SfCarousel>
    </Grid>
</ContentPage>
